# Usado pelo Docker Compose de produção. Copie para .env e substitua os exemplos.
# Somente o domínio, sem https://, porta ou caminho.
CASA_DOMAIN=casa.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# No Compose, a porta é interna e CASA_DATA_DIR=/app/.data usa volume persistente.
# CASA_TRUST_PROXY=1 já é aplicado somente ao app atrás do Caddy.
# Para npm run dev/npm start, configure variáveis no terminal (veja o LEIA-ME).
# O servidor customizado não lê este arquivo .env automaticamente.
