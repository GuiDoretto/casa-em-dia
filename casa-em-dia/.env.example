# Copie para .env ao lado de server.mjs. O servidor lê .env ao iniciar.
# Variáveis já definidas no terminal/contêiner têm prioridade sobre o arquivo.

# Produção com Docker Compose e Caddy: só domínio, sem https://, porta ou caminho.
CASA_DOMAIN=casa.seudominio.com.br
ACME_EMAIL=voce@seudominio.com.br

# Opcional: endereço público completo incluído nos links dos avisos.
# Em produção, preencha com seu endereço real, por exemplo:
# CASA_PUBLIC_URL=https://casa.seudominio.com.br
# Vazio: os avisos não incluem link. Não use o domínio de exemplo sem substituí-lo.
CASA_PUBLIC_URL=

# E-mail transacional: conta Brevo aprovada e remetente verificado.
# Crie uma chave de API na Brevo; não use a chave SMTP.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME="Casa em Dia"

# SMS é pago e fica desligado. Habilite só depois de comprar créditos e
# registrar o Sender ID por país, quando exigido pela Brevo.
# Cada morador também precisa autorizar SMS no próprio perfil.
CASA_SMS_ENABLED=0
BREVO_SMS_SENDER=CasaEmDia

# No Compose, PORT=3000 é interno e CASA_DATA_DIR=/app/.data usa volume persistente.
# CASA_TRUST_PROXY=1 é aplicado somente ao app atrás do Caddy.
# Para uso local, HOST/PORT/CASA_DATA_DIR podem ser definidos aqui ou no terminal.
# Consulte docs/NOTIFICACOES.md. Nunca compartilhe .env ou chaves reais.
