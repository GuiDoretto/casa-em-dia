{
  "name": "casa-em-dia",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Agenda compartilhada da república com React, Next.js e SQLite.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "dev": "node server.mjs --dev",
    "build": "next build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "secrets:cloudflare": "node scripts/cloudflare-secrets.mjs",
    "test:cloudflare": "node test/cloudflare-smoke.mjs",
    "test:ui": "node test/ui-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "playwright": "^1.64.1",
    "wrangler": "4.151.2"
  }
}
